{
  "pdf": {
    "engine": "xelatex",
    "margin_top": "2cm",
    "margin_bottom": "2cm", 
    "margin_left": "2cm",
    "margin_right": "2cm",
    "font_size": "12pt",
    "font_family": "SimSun",
    "paper_size": "a4",
    "toc": false,
    "number_sections": false
  },
  "markdown": {
    "variant": "gfm",
    "wrap": "auto",
    "columns": 80,
    "preserve_tabs": false,
    "tab_stop": 4
  },
  "paths": {
    "input_dir": "input",
    "output_dir": "output", 
    "temp_dir": "temp",
    "log_dir": "logs"
  },
  "logging": {
    "level": "info",
    "file": "logs/conversion.log",
    "show_progress": true
  },
  "conversion": {
    "overwrite_existing": false,
    "create_subdirs": true,
    "preserve_structure": true,
    "batch_size": 10
  }
}
